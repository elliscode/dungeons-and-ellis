{
  "name": "d-and-e",
  "version": "0.1.0",
  "private": true,
  "description": "One & Done — a lightweight DM-run virtual tabletop for one-shots",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "placeholders": "node scripts/gen-placeholders.js",
    "validate:characters": "node scripts/validate-characters.js",
    "validate:monsters": "node scripts/validate-monsters.js",
    "validate:npcs": "node scripts/validate-npcs.js",
    "build:monster-schema": "node scripts/build-monster-schema.js",
    "build:npc-schema": "node scripts/build-npc-schema.js",
    "build:schemas": "node scripts/build-monster-schema.js && node scripts/build-npc-schema.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "socket.io-client": "^4.8.1"
  }
}
