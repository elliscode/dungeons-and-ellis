# Copy to .env and fill in. `npm start` loads it automatically.
DM_PASSWORD=change-me
# Signs the DM login cookie. Any long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Public base URL, used for absolute link-preview (Open Graph) URLs.
PUBLIC_URL=https://oneshot.elliscode.com
PORT=3000
# Caddy proxies to localhost, so keep the app off the network directly.
HOST=127.0.0.1
# Set to true when served over HTTPS (behind Caddy) so the DM cookie is Secure-only.
SECURE_COOKIES=true
# How long a disconnected player shows as "reconnecting" before "offline" (characters are never auto-released).
RECONNECT_GRACE_MS=60000
# DB_FILE=data/one-and-done.sqlite
