{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dungeons-and-ellis/schemas/character.schema.json",
  "title": "One & Done hero character",
  "description": "A playable hero for One & Done, a grid-based tabletop game. All combat mechanics come from structured fields; `description` text is flavor shown in the UI and never drives mechanics. Combat: each round has a PLAYER PHASE and a DM PHASE. A hero gets 1 action per player phase plus `movement` squares. On their action they use a weapon attack or an ability (abilities with actionCost 0 are free). Attacks roll `attack` (always 1d20+N) against the target's `defense`; on a hit, roll `damage`. Role bonuses are automatic, so don't add abilities for them: tanks take ¼ of incoming damage (minimum 1), DPS deal 4× damage, and healers heal for 4× (capped at max HP). Write dice at normal values; the multipliers are applied on top. Distances are grid squares (1 = adjacent).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "role",
    "image",
    "maxHp",
    "movement",
    "defense",
    "attacks",
    "abilities",
    "inventory"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/id",
      "description": "Unique kebab-case id for the character archetype, e.g. \"frost-sorcerer\". Must not clash with an existing character id."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "Display name, e.g. \"Ilyra Snowspell\"."
    },
    "role": {
      "enum": [
        "tank",
        "dps",
        "heal"
      ],
      "description": "tank: high HP/Defense, protects allies; automatically takes ¼ damage. dps: deals damage; automatically deals 4× damage. heal: restores HP and supports; automatically heals for 4×."
    },
    "image": {
      "type": "string",
      "pattern": "^/static/tokens/[A-Za-z0-9_.-]+\\.(?:webp|png|svg|jpg|jpeg)$",
      "description": "Token image. Use \"/static/tokens/token_NNN.webp\" with NNN from 001 to 213 (zero-padded) unless told otherwise."
    },
    "maxHp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999,
      "description": "Typical: tank 40–48, dps 29–36, heal 30–36."
    },
    "movement": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20,
      "description": "Squares per phase. Typical: tank 4–5, dps 6–7, heal 5–7."
    },
    "defense": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30,
      "description": "Number an attack roll must meet or beat to hit. Typical: tank 16–19, dps 13–15, heal 13–17."
    },
    "actions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "description": "Actions per player phase. Leave this out (default 1) unless explicitly asked."
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "w",
        "h"
      ],
      "description": "Footprint in squares. Leave out for normal 1×1 heroes.",
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "h": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "attacks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/weaponAttack"
      },
      "description": "Basic weapon attacks, usable once per action. Roster heroes have exactly 2 (usually one melee range 1, one ranged)."
    },
    "abilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/ability"
      },
      "description": "Special abilities. Roster heroes have 2–3."
    },
    "inventory": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/id",
        "description": "Item id, kebab-case, e.g. \"healing-potion\"."
      },
      "description": "Flavor items. Roster heroes carry 3, usually including \"healing-potion\"."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 60
    },
    "dice": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^(?:[1-9]|[1-4][0-9]|50)d(?:4|6|8|10|12|20)(?:[+-](?:(?:[1-9]|[1-4][0-9]|50)d(?:4|6|8|10|12|20)|[0-9]{1,3}))*$",
      "description": "Dice expression: NdS terms (S is 4, 6, 8, 10, 12 or 20) and flat modifiers joined by + or -, e.g. \"2d6+3\", \"1d8+1d6\". No spaces."
    },
    "attackRoll": {
      "type": "string",
      "pattern": "^1d20(?:[+-][0-9]{1,2})?$",
      "description": "A d20 roll with a flat modifier, e.g. \"1d20+5\". Typical modifiers are +3 to +6."
    },
    "damageType": {
      "enum": [
        "slashing",
        "piercing",
        "bludgeoning",
        "fire",
        "cold",
        "lightning",
        "thunder",
        "radiant",
        "necrotic",
        "arcane",
        "force",
        "psychic",
        "poison",
        "acid",
        "nature"
      ],
      "description": "Optional. Everything except slashing/piercing/bludgeoning counts as magical (matters for magicalOnly protections). Leave out for plain physical attacks."
    },
    "status": {
      "enum": [
        "frightened",
        "snared",
        "shaken",
        "poisoned",
        "slowed"
      ],
      "description": "frightened: can't move closer to the caster. snared: movement 0. shaken/poisoned: −2 to hit. slowed: label only (use modify_movement for a real slow)."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "Name shown on the token and in the feed. Defaults to the ability name."
    },
    "when": {
      "enum": [
        "attack_hits",
        "attack_misses"
      ],
      "description": "Run this effect only if an earlier attack effect in the same ability hit (or missed)."
    },
    "duration": {
      "description": "How long the effect lasts. current_turn: until this phase ends. until_next_player_phase. next_dm_phase: through the end of the next DM phase (the usual choice). combat: until combat ends. until_used: no time limit, removed when consumed. {\"phases\": N}: N phase transitions.",
      "oneOf": [
        {
          "enum": [
            "current_turn",
            "until_next_player_phase",
            "next_dm_phase",
            "combat",
            "until_used"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phases"
          ],
          "properties": {
            "phases": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        }
      ]
    },
    "trigger": {
      "enum": [
        "next_hit",
        "next_magical_hit",
        "next_attack_against_self",
        "until_used",
        "until_next_heal_by_caster"
      ],
      "description": "Consumes the effect the first time this happens. Most effects already have a sensible default; only set it to override."
    },
    "weaponAttack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "attack",
        "damage",
        "range"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "attack": {
          "$ref": "#/$defs/attackRoll"
        },
        "damage": {
          "$ref": "#/$defs/dice",
          "description": "Typical: 1d6+2 to 1d12+4, or 2d4+4 / 2d6+3 for strong attacks."
        },
        "range": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30,
          "description": "1 = melee. Ranged weapons are typically 4–12."
        }
      }
    },
    "ability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "actionCost",
        "range",
        "effects",
        "description"
      ],
      "description": "Effects run top to bottom. An ability needs at most one picked target: the first effect that targets enemy/ally/ally_or_self/cell decides what the player picks.",
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "Unique within this character."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "actionCost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Actions spent. 1 is normal; 0 means free (pair free abilities with usesPerPhase: 1 unless trivial)."
        },
        "range": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30,
          "description": "Targeting range in squares; 0 for self/around-self abilities."
        },
        "usesPerPhase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Max uses per combat phase. Required if any effect is grant_actions."
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "One player-facing sentence that matches what the effects actually do."
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "effects"
            ],
            "properties": {
              "effects": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "grant_actions"
                    }
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "usesPerPhase"
            ]
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "actionCost"
            ],
            "properties": {
              "actionCost": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "effects": {
                "type": "array",
                "items": {
                  "if": {
                    "type": "object",
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "const": "grant_actions"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "amount": {
                        "const": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "effect": {
      "description": "One step of an ability. `type` picks the shape. Target meanings: self; enemy / ally / ally_or_self = the creature the player picks; cell = a square the player picks; enemies_in_area / allies_in_area = everyone in a radius; hit_enemies = enemies hit by an earlier attack effect in this ability; checked_enemy = the subject inside roll_to_apply / dm_check outcomes. Omit `target` to use the default.",
      "discriminator": {
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/effect_attack"
        },
        {
          "$ref": "#/$defs/effect_multi_attack"
        },
        {
          "$ref": "#/$defs/effect_area_attack"
        },
        {
          "$ref": "#/$defs/effect_chain_attack"
        },
        {
          "$ref": "#/$defs/effect_heal"
        },
        {
          "$ref": "#/$defs/effect_chain_heal"
        },
        {
          "$ref": "#/$defs/effect_modify_healing"
        },
        {
          "$ref": "#/$defs/effect_grant_protection"
        },
        {
          "$ref": "#/$defs/effect_absorb_next_hit"
        },
        {
          "$ref": "#/$defs/effect_redirect_next_hit"
        },
        {
          "$ref": "#/$defs/effect_defense_bonus"
        },
        {
          "$ref": "#/$defs/effect_modify_damage_received"
        },
        {
          "$ref": "#/$defs/effect_modify_damage_dealt"
        },
        {
          "$ref": "#/$defs/effect_modify_movement"
        },
        {
          "$ref": "#/$defs/effect_taunt"
        },
        {
          "$ref": "#/$defs/effect_reduce_actions"
        },
        {
          "$ref": "#/$defs/effect_mark_target"
        },
        {
          "$ref": "#/$defs/effect_grant_roll_bonus"
        },
        {
          "$ref": "#/$defs/effect_apply_status"
        },
        {
          "$ref": "#/$defs/effect_remove_status"
        },
        {
          "$ref": "#/$defs/effect_discourage_attacks"
        },
        {
          "$ref": "#/$defs/effect_grant_actions"
        },
        {
          "$ref": "#/$defs/effect_teleport"
        },
        {
          "$ref": "#/$defs/effect_narrative"
        },
        {
          "$ref": "#/$defs/effect_create_barrier"
        },
        {
          "$ref": "#/$defs/effect_healing_aura"
        },
        {
          "$ref": "#/$defs/effect_roll_to_apply"
        },
        {
          "$ref": "#/$defs/effect_dm_check"
        }
      ]
    },
    "nestedEffects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/effect"
      },
      "description": "Effects applied to the subject; target them at \"checked_enemy\" (or \"self\" for the caster)."
    },
    "effect_attack": {
      "type": "object",
      "description": "One attack roll against the target's Defense, then damage on a hit.",
      "additionalProperties": false,
      "required": [
        "type",
        "attack",
        "damage"
      ],
      "properties": {
        "type": {
          "const": "attack"
        },
        "target": {
          "enum": [
            "enemy",
            "checked_enemy"
          ]
        },
        "range": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30,
          "description": "Max distance in grid squares to the picked target. Usually equal to the ability range."
        },
        "attack": {
          "$ref": "#/$defs/attackRoll"
        },
        "damage": {
          "$ref": "#/$defs/dice",
          "description": "Damage dice rolled on a hit, e.g. \"2d8+2\". A crit doubles the dice, not the modifier."
        },
        "attackBonus": {
          "type": "integer",
          "minimum": -10,
          "maximum": 10,
          "description": "Flat bonus added to the attack roll. Usually leave out and put the bonus in `attack`."
        },
        "defenseReduction": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "Treat the target's Defense as this much lower for this attack only."
        },
        "damageBonus": {
          "type": "integer",
          "minimum": -20,
          "maximum": 50,
          "description": "Flat bonus added to the damage roll. Usually leave out and put it in `damage`."
        },
        "damageType": {
          "$ref": "#/$defs/damageType"
        },
        "when": {
          "$ref": "#/$defs/when"
        }
      }
    },
    "effect_multi_attack": {
      "type": "object",
      "description": "Several independent strikes on one target (each its own attack and damage roll). The ability pays actionCost once. Remaining strikes are lost if the target dies.",
      "additionalProperties": false,
      "required": [
        "type",
        "attack",
        "damage",
        "count"
      ],
      "properties": {
        "type": {
          "const": "multi_attack"
        },
        "target": {
          "enum": [
            "enemy",
            "checked_enemy"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10,
          "description": "Number of strikes."
        },
        "range": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30,
          "description": "Max distance in grid squares to the picked target. Usually equal to the ability range."
        },
        "attack": {
          "$ref": "#/$defs/attackRoll"
        },
        "damage": {
          "$ref": "#/$defs/dice",
          "description": "Damage dice rolled on a hit, e.g. \"2d8+2\". A crit doubles the dice, not the modifier."
        },
        "attackBonus": {
          "type": "integer",
          "minimum": -10,
          "maximum": 10,
          "description": "Flat bonus added to the attack roll. Usually leave out and put the bonus in `attack`."
        },
        "defenseReduction": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "Treat the target's Defense as this much lower for this attack only."
        },
        "damageBonus": {
          "type": "integer",
          "minimum": -20,
          "maximum": 50,
          "description": "Flat bonus added to the damage roll. Usually leave out and put it in `damage`."
        },
        "damageType": {
          "$ref": "#/$defs/damageType"
        },
        "when": {
          "$ref": "#/$defs/when"
        }
      }
    },
    "effect_area_attack": {
      "type": "object",
      "description": "Every enemy within `radius` of the center gets its own attack roll and damage roll.",
      "additionalProperties": false,
      "required": [
        "type",
        "attack",
        "damage",
        "radius"
      ],
      "properties": {
        "type": {
          "const": "area_attack"
        },
        "target": {
          "enum": [
            "enemies_in_area"
          ]
        },
        "center": {
          "enum": [
            "self",
            "target"
          ],
          "description": "\"self\" = burst around the caster (set ability range 0). \"target\" = player picks an enemy within `range` and the burst centers on it. Default \"self\"."
        },
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "Burst radius in squares (default 1)."
        },
        "range": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30,
          "description": "Max distance in grid squares to the picked target. Usually equal to the ability range."
        },
        "attack": {
          "$ref": "#/$defs/attackRoll"
        },
        "damage": {
          "$ref": "#/$defs/dice",
          "description": "Damage dice rolled on a hit, e.g. \"2d8+2\". A crit doubles the dice, not the modifier."
        },
        "attackBonus": {
          "type": "integer",
          "minimum": -10,
          "maximum": 10,
          "description": "Flat bonus added to the attack roll. Usually leave out and put the bonus in `attack`."
        },
        "defenseReduction": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "Treat the target's Defense as this much lower for this attack only."
        },
        "damageBonus": {
          "type": "integer",
          "minimum": -20,
          "maximum": 50,
          "description": "Flat bonus added to the damage roll. Usually leave out and put it in `damage`."
        },
        "damageType": {
          "$ref": "#/$defs/damageType"
        },
        "when": {
          "$ref": "#/$defs/when"
        }
      }
    },
    "effect_chain_attack": {
      "type": "object",
      "description": "Hits the picked enemy, then up to `jumps` more enemies the player picks; each jump must be within `jumpRange` of the previous target, no repeats.",
      "additionalProperties": false,
      "required": [
        "type",
        "attack",
        "damage",
        "jumps"
      ],
      "properties": {
        "type": {
          "const": "chain_attack"
        },
        "target": {
          "enum": [
            "enemy",
            "checked_enemy"
          ]
        },
        "jumps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "jumpRange": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "Max squares between chain links (default 3)."
        },
        "range": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30,
          "description": "Max distance in grid squares to the picked target. Usually equal to the ability range."
        },
        "attack": {
          "$ref": "#/$defs/attackRoll"
        },
        "damage": {
          "$ref": "#/$defs/dice",
          "description": "Damage dice rolled on a hit, e.g. \"2d8+2\". A crit doubles the dice, not the modifier."
        },
        "attackBonus": {
          "type": "integer",
          "minimum": -10,
          "maximum": 10,
          "description": "Flat bonus added to the attack roll. Usually leave out and put the bonus in `attack`."
        },
        "defenseReduction": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "Treat the target's Defense as this much lower for this attack only."
        },
        "damageBonus": {
          "type": "integer",
          "minimum": -20,
          "maximum": 50,
          "description": "Flat bonus added to the damage roll. Usually leave out and put it in `damage`."
        },
        "damageType": {
          "$ref": "#/$defs/damageType"
        },
        "when": {
          "$ref": "#/$defs/when"
        }
      }
    },
    "effect_heal": {
      "type": "object",
      "description": "Rolls `heal` and restores that much HP (capped at max HP). Dead creatures cannot be healed.",
      "additionalProperties": false,
      "required": [
        "type",
        "heal"
      ],
      "properties": {
        "type": {
          "const": "heal"
        },
        "target": {
          "enum": [
            "self",
            "ally",
            "ally_or_self",
            "allies_in_area"
          ],
          "description": "\"allies_in_area\" heals every ally (and the caster) within `radius` of the caster."
        },
        "heal": {
          "$ref": "#/$defs/dice"
        },
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "Only with target \"allies_in_area\" (default 1)."
        },
        "range": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30,
          "description": "Max distance in grid squares to the picked target. Usually equal to the ability range."
        },
        "when": {
          "$ref": "#/$defs/when"
        }
      }
    },
    "effect_chain_heal": {
      "type": "object",
      "description": "Heals the picked ally, then up to `jumps` more wounded allies the player picks, each within `jumpRange` of the previous one. Each heal is rolled separately.",
      "additionalProperties": false,
      "required": [
        "type",
        "heal",
        "jumps"
      ],
      "properties": {
        "type": {
          "const": "chain_heal"
        },
        "target": {
          "enum": [
            "ally_or_self",
            "ally"
          ]
        },
        "heal": {
          "$ref": "#/$defs/dice"
        },
        "jumps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "jumpRange": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "Default 3."
        },
        "range": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30,
          "description": "Max distance in grid squares to the picked target. Usually equal to the ability range."
        },
        "when": {
          "$ref": "#/$defs/when"
        }
      }
    },
    "effect_modify_healing": {
      "type": "object",
      "description": "The caster's next heal on the target gets +amount.",
      "additionalProperties": false,
      "required": [
        "type",
        "amount"
      ],
      "properties": {
        "type": {
          "const": "modify_healing"
        },
        "target": {
          "enum": [
            "ally",
            "ally_or_self"
          ]
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
